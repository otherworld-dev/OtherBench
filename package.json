{
  "name": "otherbench",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "workspaces": ["packages/*", "desktop"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc -b && node scripts/typecheck-tests.mjs",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "dev": "npm run dev -w @otherbench/server",
    "serve": "node packages/server/dist/cli.js serve"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.62.1"
  }
}
