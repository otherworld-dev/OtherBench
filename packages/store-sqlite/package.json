{
  "name": "@otherbench/store-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db.js": { "types": "./dist/db.d.ts", "default": "./dist/db.js" },
    "./store.js": { "types": "./dist/store.d.ts", "default": "./dist/store.js" },
    "./secret-store.js": { "types": "./dist/secret-store.d.ts", "default": "./dist/secret-store.js" },
    "./blob-store.js": { "types": "./dist/blob-store.d.ts", "default": "./dist/blob-store.js" },
    "./blob-gc.js": { "types": "./dist/blob-gc.d.ts", "default": "./dist/blob-gc.js" },
    "./backup.js": { "types": "./dist/backup.d.ts", "default": "./dist/backup.js" },
    "./migrations/*.js": { "types": "./dist/migrations/*.d.ts", "default": "./dist/migrations/*.js" }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@otherbench/core": "*"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
