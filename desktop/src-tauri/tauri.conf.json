{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OtherBench",
  "version": "../package.json",
  "identifier": "dev.otherworld.otherbench",
  "build": {
    "frontendDist": "../../packages/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OtherBench",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "create": false,
        "title": "OtherBench quick chat",
        "url": "index.html?view=quick",
        "width": 560,
        "height": 380,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' blob: data: http://127.0.0.1:*; media-src blob: http://127.0.0.1:*; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRkU4NjM0OTNGNUMxNkUKUldSdXdmV1ROSWIrcXY4UGU0TS80TWFRVUtUcmJYWUI3WUI3V3laS0xPbk0wbGM1QVVGczdjN1MK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
